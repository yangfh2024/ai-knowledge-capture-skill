      "status": "active",
      "title": "一个 Project 对应一个品牌"
    },
    {
      "id": "STATE-SHOPMEMO-DRAFT-001",
      "type": "state",
      "project": "shopmemo",
      "status": "superseded",
      "title": "ShopMemo 正在开发"
    },
    {
      "id": "STATE-SHOPMEMO-LAUNCH-001",
      "type": "state",
      "project": "shopmemo",
      "status": "active",
      "title": "ShopMemo 已完成核心功能并进入冷启动"
    },
    {
      "id": "DEC-SHOPMEMO-ENGLISH-001",
      "type": "decision",
      "project": "shopmemo",
      "status": "superseded",
      "title": "优先做英文市场"
    },
    {
      "id": "DEC-SHOPMEMO-CHINESE-001",
      "type": "decision",
      "project": "shopmemo",
      "status": "active",
      "title": "改为中文市场优先"
