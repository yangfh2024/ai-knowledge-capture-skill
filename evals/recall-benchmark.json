{
  "benchmark_version": "0.2",
  "metrics": {
    "recall_hit": {
      "definition": "clean_result 必须返回 expected_relevant_ids 的全部 ID。",
      "target": "all_required_ids_returned"
    },
    "wrong_recall": {
      "definition": "returned_ids 中不属于 allowed_ids 的数量必须为 0。",
      "target": "zero_disallowed_ids"
    },
    "context_pollution": {
      "definition": "injected_ids 不得包含 forbidden_ids、superseded 或 pending 记忆。",
      "target": "zero_forbidden_or_inactive_injected"
    }
  },
  "memory_catalog": [
    {
      "id": "PROJ-OPEN-MEMORY-001",
      "type": "project",
      "project": "open-memory",
      "status": "active",
      "title": "跨 Agent Memory Skill"
    },
    {
      "id": "DEC-OPEN-MEMORY-MARKDOWN-001",
      "type": "decision",
      "project": "open-memory",
      "status": "active",
      "title": "Markdown 作为事实源"
    },
    {
      "id": "STATE-OPEN-MEMORY-RECALL-001",
      "type": "state",
      "project": "open-memory",
      "status": "active",
      "title": "下一步验证跨 Agent Recall"
    },
    {
      "id": "DEC-SHOPMEMO-BRAND-001",
