  "cases": [
    {
      "id": "RB-01",
      "name": "项目连续性",
      "query": "昨天那个跨 Agent Memory 项目下一步做什么？",
      "context": {
        "project": "open-memory"
      },
      "expected_relevant_ids": [
        "STATE-OPEN-MEMORY-RECALL-001"
      ],
      "allowed_ids": [
        "PROJ-OPEN-MEMORY-001",
        "DEC-OPEN-MEMORY-MARKDOWN-001",
        "STATE-OPEN-MEMORY-RECALL-001"
      ],
      "forbidden_ids": [
        "PROJ-TEMU-001",
        "DEC-TEMU-SEO-001"
      ],
      "clean_result": {
        "returned_ids": [
          "STATE-OPEN-MEMORY-RECALL-001"
        ],
        "injected_ids": [
          "STATE-OPEN-MEMORY-RECALL-001"
        ]
      },
      "wrong_recall_probe": {
        "returned_ids": [
          "STATE-OPEN-MEMORY-RECALL-001",
