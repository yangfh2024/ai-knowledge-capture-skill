{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yangfh2024/ai-knowledge-capture-skill/schema/memory-item.schema.json",
  "title": "Memory Item",
  "description": "Normalized metadata for one confirmed or pending Markdown memory item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "created_at",
    "updated_at",
    "source",
    "project",
    "tags",
    "importance",
    "confidence",
    "status",
    "scope",
    "supersedes",
    "superseded_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "profile",
        "preference",
        "project",
        "state",
        "decision",
        "knowledge",
        "case"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "project": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "importance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "superseded",
        "rejected",
        "archived"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "formal",
        "inbox"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "inbox"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "pending"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "formal"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "superseded",
              "rejected",
              "archived"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "const": "formal"
          },
          "superseded_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "superseded_by": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "scope": {
            "const": "inbox"
          }
        }
      }
    }
  ]
}
